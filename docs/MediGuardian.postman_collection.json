{
  "info": {
    "name": "MediGuardian API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "email",
      "value": "you@example.com"
    },
    {
      "key": "password",
      "value": "CorrectHorse9"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "deviceToken",
      "value": "mgd_PASTE_FROM_register-box"
    },
    {
      "key": "patientId",
      "value": ""
    },
    {
      "key": "drawerId",
      "value": ""
    },
    {
      "key": "extraDrawerId",
      "value": ""
    },
    {
      "key": "medicineId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Farhan\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"01700000000\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Patients & boxes",
      "item": [
        {
          "name": "Create patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "patients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahela Begum\",\n  \"relationship\": \"Mother\",\n  \"timezone\": \"Asia/Dhaka\"\n}"
            }
          }
        },
        {
          "name": "List patients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "patients"
              ]
            }
          }
        },
        {
          "name": "Pair box",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/boxes/pair",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "boxes",
                "pair"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"boxCode\": \"MG-XXXX-XXXX-XXXX\",\n  \"pairingCode\": \"XXXX-XXXX-XXXX\",\n  \"patientId\": \"{{patientId}}\"\n}"
            }
          }
        },
        {
          "name": "List boxes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/boxes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "boxes"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Medicines",
      "item": [
        {
          "name": "Add medicine (fixed times)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/patients/{{patientId}}/medicines",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "patients",
                "{{patientId}}",
                "medicines"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"NAPA Extra\",\n  \"dose\": \"1 Tablet\",\n  \"doseQuantity\": 1,\n  \"quantity\": 30,\n  \"drawerId\": \"{{drawerId}}\",\n  \"schedule\": {\n    \"type\": \"times\",\n    \"times\": [\n      \"08:00\",\n      \"20:00\"\n    ]\n  }\n}"
            }
          }
        },
        {
          "name": "Add medicine (every 8h, Extra drawer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/patients/{{patientId}}/medicines",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "patients",
                "{{patientId}}",
                "medicines"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Antibiotic\",\n  \"quantity\": 21,\n  \"drawerId\": \"{{extraDrawerId}}\",\n  \"schedule\": {\n    \"type\": \"interval\",\n    \"everyHours\": 8,\n    \"anchor\": \"06:00\"\n  }\n}"
            }
          }
        },
        {
          "name": "Refill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/medicines/{{medicineId}}/refill",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "medicines",
                "{{medicineId}}",
                "refill"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10,\n  \"note\": \"pharmacy\"\n}"
            }
          }
        },
        {
          "name": "Today's doses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/patients/{{patientId}}/today",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "patients",
                "{{patientId}}",
                "today"
              ]
            }
          }
        },
        {
          "name": "Report 7D",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports?patientId={{patientId}}&range=7D",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reports?patientId={{patientId}}&range=7D"
              ]
            }
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "dashboard"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Device (ESP32)",
      "item": [
        {
          "name": "Heartbeat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{deviceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/device/heartbeat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "device",
                "heartbeat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firmware_version\": \"1.0.0\",\n  \"power_state\": \"on\",\n  \"refill_mode\": false,\n  \"config_version\": 0\n}"
            }
          }
        },
        {
          "name": "Get config",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{deviceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/device/config?since=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "device",
                "config?since=0"
              ]
            }
          }
        },
        {
          "name": "Ack config",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{deviceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/device/config/ack",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "device",
                "config",
                "ack"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": 1,\n  \"status\": \"applied\"\n}"
            }
          }
        },
        {
          "name": "Send removal event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{deviceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/device/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "device",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"event_id\": \"box1-000001\",\n      \"type\": \"removal_detected\",\n      \"drawer\": 1,\n      \"occurred_at\": \"2026-10-24T08:12:30Z\",\n      \"sensors\": {\n        \"reed_open\": true,\n        \"ir_a\": true,\n        \"ir_b\": false\n      },\n      \"refill_mode\": false\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{deviceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/device/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "device",
                "status"
              ]
            }
          }
        }
      ]
    }
  ]
}